{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HQ Network Debugger",
  "version": "1.0.0",
  "identifier": "com.hq.networkcapture",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:8899",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run tauri:prep"
  },
  "app": {
    "windows": [
      {
        "title": "HQ Network Debugger & MapLocal Mock",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "url": "http://localhost:8899"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "backend/"
    ]
  }
}
